# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Environments
# Anchored to the repo root: a bare "env/" also matches configs/env/, which
# silently excluded the environment configs and left the published repo
# unable to train.
/.venv/
/venv/
/env/
.python-version

# Training artefacts: runs are reproducible from configs, so they are not
# committed. Curated results in results/ are.
runs/
wandb/
*.zip
*.pth
*.pt
!results/**/*.zip

# Stray run artefacts
*.log

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Hydra
outputs/
multirun/

# A registered run's finished episodes while it is running (scripts/resumable.py);
# deleted when the run completes, kept only by an interrupted one.
*.checkpoint.jsonl
